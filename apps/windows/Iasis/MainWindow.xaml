<Window
    x:Class="Iasis.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Iasis"
    Title="Iasis">
    <Grid x:Name="Root" RowDefinitions="Auto,Auto,Auto,*">
        <Grid.Resources>
            <CollectionViewSource x:Key="Groups" IsSourceGrouped="True" ItemsPath="Ports" />
        </Grid.Resources>
        <TitleBar x:Name="AppTitleBar" Title="Iasis" />
        <InfoBar x:Name="Connection" Grid.Row="1" IsClosable="False" Margin="16,0" />
        <InfoBar x:Name="Problem" Grid.Row="2" Severity="Error" Margin="16,0" />
        <NavigationView x:Name="Navigation" Grid.Row="3" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" SelectionChanged="Navigate">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DevicesTab" Content="Devices" Icon="AllApps" />
                <NavigationViewItem x:Name="ImagesTab" Content="Images" Icon="Library" />
                <NavigationViewItem x:Name="SettingsTab" Content="Settings" Icon="Setting" />
            </NavigationView.MenuItems>
            <Grid Margin="16,8,16,16">
                <Grid x:Name="DevicesPage" RowDefinitions="Auto,*,Auto">
                    <CommandBar HorizontalAlignment="Stretch" DefaultLabelPosition="Right" OverflowButtonVisibility="Auto">
                        <AppBarButton x:Name="Dfu" Label="Enter DFU" Icon="Download" Click="EnterDfu" />
                        <AppBarButton x:Name="Restart" Label="Restart" Icon="Refresh" Click="RestartDevice" />
                        <AppBarButton x:Name="Revive" Label="Revive" Icon="Repair" Click="ReviveDevice" />
                        <AppBarButton x:Name="Restore" Label="Restore…" Icon="Undo" Click="RestoreDevice" />
                    </CommandBar>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                        <ListView x:Name="Ports" ItemsSource="{Binding Source={StaticResource Groups}}" SelectionMode="Extended"
                                  SelectionChanged="SelectionChanged" ContextRequested="PortContextRequested"
                                  ContextCanceled="PortContextCanceled" AutomationProperties.Name="Hub ports">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate x:DataType="local:HubRow">
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:PortRow">
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="Empty" Text="Connect an Iasis hub." HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ScrollViewer x:Name="Inspector" Grid.Column="1" Width="264" Padding="12" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="DeviceTitle" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="Details" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <ProgressBar x:Name="Progress" Maximum="100" />
                                <TextBlock x:Name="Steps" TextWrapping="Wrap" />
                                <TextBlock x:Name="Needs" TextWrapping="Wrap" />
                                <HyperlinkButton x:Name="GetPrerequisite" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <ScrollViewer Grid.Row="2" MaxHeight="175">
                        <StackPanel x:Name="Submissions" />
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="ImagesPage" Visibility="Collapsed" RowDefinitions="Auto,Auto,*">
                    <CommandBar HorizontalAlignment="Stretch" DefaultLabelPosition="Right">
                        <AppBarButton x:Name="Import" Label="Import IPSW…" Icon="OpenFile" Click="ImportImage" />
                        <AppBarButton x:Name="Download" Label="Download…" Icon="Download" Click="DownloadImage" />
                        <AppBarButton x:Name="Remove" Label="Remove" Icon="Delete" Click="RemoveImage" />
                    </CommandBar>
                    <StackPanel x:Name="DownloadProgress" Grid.Row="1" Spacing="4" Margin="12,4">
                        <TextBlock x:Name="FetchTitle" />
                        <ProgressBar x:Name="FetchProgress" Maximum="100" />
                    </StackPanel>
                    <ListView x:Name="ImageList" Grid.Row="2" SelectionMode="Single" KeyDown="ImageKeyDown"
                              SelectionChanged="ImageSelectionChanged" AutomationProperties.Name="Restore images">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ImageRow">
                                <SwipeControl>
                                    <SwipeControl.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Remove" Tag="{x:Bind}" Click="RemoveContextImage" />
                                        </MenuFlyout>
                                    </SwipeControl.ContextFlyout>
                                    <SwipeControl.RightItems>
                                        <SwipeItems Mode="Reveal">
                                            <SwipeItem Text="Remove" Invoked="SwipeRemoveImage" />
                                        </SwipeItems>
                                    </SwipeControl.RightItems>
                                    <StackPanel Margin="10,6">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Detail, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </SwipeControl>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="NoImages" Grid.Row="2" Text="No restore images." HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
                        <ToggleSwitch x:Name="SetupLanguage" Header="Set language and region on erased iPhones and iPads" Toggled="SetupLanguageChanged" />
                        <ToggleSwitch x:Name="EnrollmentAfterErase" Header="Try enrollment after erasing" Toggled="EnrollmentAfterEraseChanged" />
                        <TextBlock Text="An iPhone or iPad may ask you to sign in or show Partially Set Up. Continue setup on the device."
                                   Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                        <ToggleSwitch x:Name="ShutdownMacs" Header="Shut down Macs after erasing" Toggled="ShutdownMacsChanged" />
                        <ToggleSwitch x:Name="Login" Header="Open at sign-in" Toggled="LoginChanged" />
                        <TextBlock Text="Hubs" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <ComboBox x:Name="HubList" DisplayMemberPath="Title" SelectionChanged="HubChanged" PlaceholderText="Connect an Iasis hub" />
                        <TextBlock x:Name="HubStatus" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="Rename" Content="Rename…" Click="RenameHub" />
                            <Button x:Name="Brightness" Content="Light level…" Click="ChangeBrightness" />
                            <Button x:Name="Update" Content="Update IasisOS…" Click="UpdateHub" />
                        </StackPanel>
                        <TextBlock Text="Supervision identity" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="IdentityName" TextWrapping="Wrap" />
                        <TextBlock x:Name="Fingerprint" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <DropDownButton Content="Manage identity">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:Name="CertificateExport" Text="Export certificate…" Click="ExportCertificate" />
                                    <MenuFlyoutItem x:Name="IdentityExport" Text="Export identity…" Click="ExportIdentity" />
                                    <MenuFlyoutItem x:Name="IdentityImport" Text="Import identity…" Click="ImportIdentity" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem x:Name="FingerprintCopy" Text="Copy fingerprint" Click="CopyFingerprint" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <StackPanel x:Name="Prerequisites" Spacing="8" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
