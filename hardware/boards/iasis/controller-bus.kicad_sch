	(text "J1132 is the 3.3 V UART log output: NC / GND / TX solder pads.\nPower the board from its host port before using UART;\ndo not connect an adapter supply."
		(exclude_from_sim no)
		(at 177.8 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5f88d2e0-5163-46c0-906b-ca648ac59e9b")
	)
	(text "MUX_RUN is held low until firmware releases the mux.\nPhysical RESET also deselects every mux channel.\nExpander reset remains independent on GPIO32."
		(exclude_from_sim no)
		(at 25.4 180.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9c8accfc-4494-48ac-baa9-28817f2ef27d")
	)
	(text "Management buses"
		(exclude_from_sim no)
		(at 25.4 20.32 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "b7d13560-3157-4ad2-9655-434e6e5d6ef7")
	)
	(text "I2C mux address 0x70; select one channel at a time. Channels 0-4 are targets 1-5; channel 5 is the host CC controller.\nChannel 6 reaches the hub strap/status pins without pull-ups; autonomous ROM boot takes priority.\nChannel 7 is the optional display and charging-input control bus."
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ff0ef535-5fde-41a5-b007-752f0bf8424b")
	)
