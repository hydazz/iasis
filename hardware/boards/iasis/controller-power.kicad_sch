	(text "U1172 P0 / P1 / P3: DATA / CLOCK / LATCH.\nU1172 P2: host orientation. P4: HUB_RUN.\nU1172 P5 / P6: input-protection fault / charging PG.\nGPIO16 reads HOST_BUDGET_FAULT_N.\nBits 0–4 select 9 V; bit 5 turns the charging input off, bit 6 the port stages; bit 7 forces the external host.\nBits 8 and 12–15 discharge targets 1–5; bits 9–10 select host budget; bit 11 enables host targets."
		(exclude_from_sim no)
		(at 25.4 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d41a3fb2-4930-48b0-b308-6477ffc143b0")
	)
	(text "MCU GPIO37 keeps /OE high through reset. Clear all 16 bits before enabling outputs. Every controlled load has a pulldown."
		(exclude_from_sim no)
		(at 25.4 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "dbe27e6f-919f-421a-8e8e-4293440247a4")
	)
	(text "Power control registers — fitted in both populations"
		(exclude_from_sim no)
		(at 25.4 20.32 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "e7dd20cd-95e0-428c-97e6-eb5c06e331da")
	)
