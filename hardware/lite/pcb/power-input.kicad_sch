	(text "Common-source 60 V NFET pair; the main HV path defaults off.\nLM74502 OV: 249k / 10k. 22nF + 1k gate ramp controls inrush.\nKeep HV input capacitance ≤200uF; include buck startup in inrush checks.\nFive converter input filters total 100uF nominal; no extra HV bulk here.\nBucks start with HV_CHARGE. Wait for settling before enabling an output eFuse."
		(exclude_from_sim no)
		(at 287.02 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "28d0b013-3d48-4d1b-9433-ae3baa08bcb9")
	)
