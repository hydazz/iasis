	(text "USB 3.2 Gen 2 hub — target ports 1–5 and the controller"
		(exclude_from_sim no)
		(at 25.4 20.32 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "68079b1d-acbb-41c4-bd29-27e38084b6bb")
	)
	(text "Configuration 3: CFG_STRAP1 10k; CFG_STRAP2/3, NON_REM and BC_EN 200k pull-downs.\nInternal ROM boot; all ports removable; battery charging detection off.\nHUB_SCL/SDA stay low during reset for autonomous attachment.\nRESET_N = AON_RESET_N AND HUB_RUN; HUB_RUN has a pull-up.\nThe selected host reaches the hub through the host-select mux (host-port sheet).\nHUB_UP_VBUS = EXT_VBUS (divided) OR CM5_HOST through U205 on 3V3_AON; MCU firmware is not needed to enumerate.\nPort 6 USB2 connects the RP2354. Target power is controlled independently of PRT_CTL1-6.\nUpstream TX uses C222/C223; downstream TX coupling is on the repeated port sheets.\nSuperSpeed lanes support native rate negotiation; USB2 D+/D- are never polarity swapped."
		(exclude_from_sim no)
		(at 287.02 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c90acd91-f0ac-42bd-8f98-a780db8b7cc3")
	)
