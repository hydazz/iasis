	(text "J112: short each signal to its paired ground.\nBOOT: fit for USB boot. EEPROM_nWP: fit before power-up to write-protect; remove to update.\nPMIC_EN: fit to hold the CM5 off. PWR_BUT: momentary power button. Remove BOOT after service."
		(exclude_from_sim no)
		(at 248.92 104.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0d79001f-e53f-456e-b9e8-d4f9697e6b74")
	)
	(text "TP111 is a logic observation point.\nCM5 POWER_LED_N cannot directly drive an LED."
		(exclude_from_sim no)
		(at 142.24 236.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7036f8a8-ffba-4b8e-a19a-402f19ff273e")
	)
	(text "J113 uses the Intel 4-wire fan pinout: 1 GND, 2 +5V, 3 tach, 4 PWM.\nPWM is open collector; the fan pull-up runs it at full speed while the CM5 is off.\nTACHO has CM5 pullup. Fan allowance: 5V, 2W maximum."
		(exclude_from_sim no)
		(at 248.92 226.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "86ada941-cbaa-417e-b042-4d88bf2e0508")
	)
	(text "CM5 service and cooling"
		(exclude_from_sim no)
		(at 25.4 22.86 0)
		(effects
