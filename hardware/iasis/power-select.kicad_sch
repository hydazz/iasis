	)
	(text "68k / 22k selections: 00 ≤0.17 A; 10 ≤0.55 A; 01 ≤1.45 A; 11 ≤1.89 A.\nBudget the worst tier plus logic consumption. No automatic 3 A assumption.\nTarget aggregate defaults off; the hub and MCU remain powered upstream of it."
		(exclude_from_sim no)
		(at 20.32 254 0)
		(effects
			(font
