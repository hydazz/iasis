	(text "Adapter (primary)"
		(exclude_from_sim no)
		(at 25.4 50.8 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "6c259587-b895-4c73-ad78-b7b985e23a4a")
	)
	(text "Priority mux per TI SLVSFC9C 8.2.5, option 2: while 5V_AUX is valid, AUXOFF turns Q1901 on and EXT_VBUS holds the auxiliary OVLO high.\nWithout a host nothing drives EXT_VBUS: AUXOFF only reaches Q1901's gate, and Q1901 then ties EXT_VBUS to R1908.\nPrimary: UVLO 4.24V rising, OVLO 5.69V, ILM 2.2A. Auxiliary: UVLO 3.92V rising, OVLO 5.88V, ILM 3.3A.\nAuxiliary dVdt 0.043V/ms keeps bus-powered inrush near 50mA into about 1.2mF, 24V_SYS included.\nBoth channels block reverse current: the adapter never feeds the host, the host never feeds 5V_AUX.\nD1902 lifts 24V_SYS to about 4.5V in bus mode so the target converters can present 5V VBUS; it is rated for about 1A here."
		(exclude_from_sim no)
		(at 177.8 241.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d964d5ac-c525-4dfe-8ebe-9684c6264672")
	)
	(text "Host VBUS (auxiliary)"
		(exclude_from_sim no)
		(at 25.4 154.94 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "ee53615a-e2de-4150-8e12-7c78b08a30f9")
	)
