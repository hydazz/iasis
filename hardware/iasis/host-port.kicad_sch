	(text "CC / USB 2 protection and sink PD"
		(exclude_from_sim no)
		(at 25.4 184.15 0)
		(effects
			(font
				(size 1.778 1.778)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "22a14661-011b-453e-83da-43ff025509ec")
	)
	(text "Host port — front USB-C to an external computer"
		(exclude_from_sim no)
		(at 25.4 22.86 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "39cc7981-f994-4fc8-9cae-42d29e326b6d")
	)
	(text "RPD_G1/G2 tie to C_CC1/C_CC2: the dead-battery Rd asks an unpowered host port for VBUS.\nThe FUSB302B keeps its Rd and is polled on TCA9548 channel 5; INT_N has a pull-up only. VCONN is unused.\nFLT is open: a sink cannot remove the host's VBUS, and the TPD6S300A isolates CC and D+/D- itself.\nD1/D2 stay grounded: they are 6V clamps and would void the 24V short protection D+/D- get through C_SBU1/2."
		(exclude_from_sim no)
		(at 25.4 274.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8efba526-65ad-4150-b774-13b99d79b175")
	)
	(text "EXT_ORIENT=1: CC1 / TX1 / RX1. EXT_ORIENT=0: CC2 / TX2 / RX2.\nSet orientation from the host CC termination. USB2 is available before firmware runs.\nThe host supplies RX lane AC coupling; the hub supplies TX lane AC coupling.\nHUB_UP_VBUS uses 43k here and 49.9k to GND on the hub sheet.\nThe data host remains a 5 V sink; charging uses a separate power-input connector."
		(exclude_from_sim no)
		(at 25.4 145 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9362d7d0-2592-4bd4-b3e0-2e4d8b12ecfc")
	)
