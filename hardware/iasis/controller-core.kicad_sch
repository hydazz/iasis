	(text "External VCORE; disable internal regulator.\nNo POWMAN low-power transition until ENTRY/EXIT are HIZ.\nQSPI flash is inside the package; unused flash pins have no routed stubs."
		(exclude_from_sim no)
		(at 20.32 23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1694f9fe-f83a-4c18-a448-5eb06c6d0d11")
	)
	(text "BOOTSEL + RESET: recover using the same host USB cable.\nPhysical RESET restarts the hub and MCU. Firmware ROM reboot resets only the MCU."
		(exclude_from_sim no)
		(at 20.32 274.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1f30588b-5eaa-467c-8917-026a3b57323d")
	)
	(text "RESET"
		(exclude_from_sim no)
		(at 142.24 243.84 0)
		(effects
