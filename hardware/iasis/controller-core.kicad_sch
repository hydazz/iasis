		(uuid "00295836-fcde-460a-ace3-ad7e67aa7bb2")
	)
	(text "J1101: 3V3 sense / SWDIO / GND / SWCLK / GND / RESET / GND / BOOTSEL.\nFor USB boot, hold BOOTSEL low while releasing RESET. USB pads require a powered board.\nRP USB also reaches hub B DN3 for reflashing from the CM5."
		(exclude_from_sim no)
		(at 25.4 269.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "108feb08-0faf-4136-a64b-8d6886f128b1")
	)
	(text "Follow the Raspberry Pi regulator layout. Inductor pad1 is the marked output terminal.\nKeep inductor, 4.7u capacitors and VREG_AVDD filter in their prescribed orientation.\nQSPI flash is inside the package; unused flash pins have no routed stubs."
		(exclude_from_sim no)
		(at 228.6 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "34172d03-db74-4a5f-bdab-6933eee31087")
	)
