		(uuid "230dd51c-9d4d-4536-9b90-dbedbccf23d5")
	)
	(text "J1101: 3V3 sense / SWDIO / GND / SWCLK / GND / RESET / GND / BOOTSEL.\nFor USB boot, hold BOOTSEL low while releasing RESET. USB pads require a powered board.\nThe hub USB2 port 6 exposes the MCU ROM bootloader even with blank application firmware."
		(exclude_from_sim no)
		(at 25.4 261.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
