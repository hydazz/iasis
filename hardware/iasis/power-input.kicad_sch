	(text "Common-source 60 V NFET pair; the main HV path defaults off.\nLM74502 OV: 249k / 10k. 22nF + 1k gate ramp controls inrush.\nKeep HV input capacitance ≤200uF; include buck startup in inrush checks.\nFive converter input filters total 100uF nominal; no extra HV bulk here.\nBucks start with HV_CHARGE. Wait for settling before enabling an output eFuse."
		(exclude_from_sim no)
		(at 187.96 101.6 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "28d0b013-3d48-4d1b-9433-ae3baa08bcb9")
	)
	(text "Optional USB-C charging input"
		(exclude_from_sim no)
		(at 20.32 15.24 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left top)
		)
		(uuid "3cb8a82e-1b52-4bb5-92ad-15f068311fe3")
	)
	(text "CFG1 selects 20 V default. Request 28 V only after\nsource/cable capability checks. I2C mux channel 7.\nVHV and VBUS share a filtered, protected supply.\nCC pins remain connected to raw CC.\nInput transients and CC shorts need bench qualification."
		(exclude_from_sim no)
		(at 233.68 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4d4b8831-51d8-4c36-bf78-c86eee22a106")
	)
	(text "Raw-input clamp does not replace the\nCH224 supply protector below 32 V."
		(exclude_from_sim no)
		(at 25.4 121.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cfbc4fb6-f6d7-4bcb-a672-654800b6abdd")
	)
	(text "Hub population: entire sheet DNP. Charging input never powers the logic rail or bypasses a target protection switch."
		(exclude_from_sim no)
		(at 20.32 27.94 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "dfdca34a-af35-471b-894b-06db011e3bfc")
	)
