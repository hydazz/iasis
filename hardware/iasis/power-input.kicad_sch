	(text "GST220A24-R7B input. Mated contacts pair by column: J1001 1/3 GND, 2/4 +24V.\nMeter the R7B plug before first power; the LTC4368 blocks a reversed pair.\nShort RESET_INPUT to GND for at least 150ms to clear the current latch.\nRoute shunt sense connections from inner lands, separately from load current.\n47nF gate timing. Q1001 is a D2PAK sized for start-up into a 24V_SYS fault."
		(exclude_from_sim no)
		(at 190.5 246.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4a50d00f-2975-400c-9b60-b5375449ac3b")
	)
