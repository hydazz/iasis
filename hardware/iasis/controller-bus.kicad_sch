	(text "I2C mux address 0x70; select one channel at a time. Channels 0-4 are targets 1-5,\neach with FUSB302B at 0x22 and TPS55288 at 0x74; pullups are on the target sheets.\nChannel 5 is the host port. Channel 6 is the hub's SMBus client at 0x2D, with pull-ups\nfed from HUB_SMB_EN. Channel 7 is J1131, a Qwiic/STEMMA QT socket for the lid display\n(1 GND, 2 3V3_AON, 3 SDA, 4 SCL)."
		(exclude_from_sim no)
		(at 25.4 233.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e7f4bec5-a287-495a-8dd5-8bf368611d71")
	)
