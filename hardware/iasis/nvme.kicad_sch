	)
	(text "Use a PCIe NVMe SSD within the 6W power allowance.\nThe NVMe regulator runs from 5V_CM5; the CM5 enables it through PCIe_PWR_EN.\nCM5 TX and SSD TX have their own AC coupling.\nCLKREQ and WAKE have pullups on CM5.\nH171-H173 are grounded card standoffs for 2230 / 2242 / 2280."
		(exclude_from_sim no)
		(at 25.4 195.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ee555922-5f25-4993-b488-c5f7785fb6db")
	)
