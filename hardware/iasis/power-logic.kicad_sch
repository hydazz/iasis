		(uuid "0bd9788f-5337-4883-92bc-9436756a77f3")
	)
	(text "CT open: 20ms reset release delay. AON_RESET_N resets the controller, ADC switches, shift registers and hub.\n1V1_HUB is set to 1.161V (1.143-1.178V), centred in the hub's 1.09-1.21V VCORE range; 1.21V is also its absolute maximum.\n1V1_HUB regulates within the reset delay and outlasts 3V3_AON when 5V_LOGIC sags, so the hub needs no core supervisor."
		(exclude_from_sim no)
		(at 279.4 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9adbe7e3-598b-4194-9b10-5e7589820379")
	)
