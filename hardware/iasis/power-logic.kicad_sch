		(uuid "0bd9788f-5337-4883-92bc-9436756a77f3")
	)
	(text "VCORE = 1.122 V nominal. Shared USB7206 and RP2354 DVDD.\nR1060 10k / R1061 11.5k, both 0.1%; retain local bulk and decoupling."
		(exclude_from_sim no)
		(at 20.32 274.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "33ddf4a5-c523-42f1-9d42-44ac5be7a909")
	)
	(text "CT open: 20ms reset release delay. AON_RESET_N resets the MCU, ADC isolation switches and hub.\nVCORE is 1.122V nominal (static 1.102–1.142V). Verify sequencing and load transients on the prototype.\nThe MCU uses external VCORE; its internal regulator stays disabled. MCU reset disables the shift-register outputs."
		(exclude_from_sim no)
		(at 279.4 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9adbe7e3-598b-4194-9b10-5e7589820379")
	)
