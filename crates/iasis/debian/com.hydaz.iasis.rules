// The iasis service holds a sleep lock while it restores a device or updates
// a hub. It has no login session, so logind asks polkit for it.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.login1.inhibit-block-sleep" &&
        subject.user == "iasis") {
        return polkit.Result.YES;
    }
});
