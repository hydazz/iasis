[Unit]
Description=Iasis host agent
Documentation=https://github.com/hydazz/iasis
After=network.target

[Service]
ExecStart=/usr/libexec/iasis/iasisd
User=iasis
Group=iasis
# Its USB devices belong to this group, which only the agent's user is in.
SupplementaryGroups=iasis-usb
StateDirectory=iasis
CacheDirectory=iasis
RuntimeDirectory=iasis
RuntimeDirectoryMode=0750
# The internet gateway brings each target's USB network link up and
# exchanges its frames.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
Restart=on-failure

[Install]
WantedBy=multi-user.target
