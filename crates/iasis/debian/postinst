#!/bin/sh
set -e

if [ "$1" = configure ]; then
    # Hubs and targets already attached take the rules' group before the
    # agent starts below, so it finds them open.
    systemd-sysusers ${DPKG_ROOT:+--root="$DPKG_ROOT"} iasis.conf
    if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/udev ]; then
        udevadm control --reload-rules || true
        for vendor in 1209 2e8a 05ac; do
            udevadm trigger --action=change --subsystem-match=usb --attr-match=idVendor="$vendor" || true
        done
        udevadm settle --timeout=10 || true
    fi
fi

#DEBHELPER#
