{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>hydazz/renovate-config"],
  packageRules: [
    {
      description: "Embassy crates share driver and time traits",
      matchManagers: ["cargo"],
      matchPackageNames: ["embassy-*"],
      groupName: "embassy",
      groupSlug: "embassy",
    },
    {
      description: "cadquery-ocp has no Python 3.15 wheels",
      matchDepNames: ["python"],
      allowedVersions: "<3.15",
    },
  ],
}
